<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.tipcalculator.TipCalculatorController"
      alignment="CENTER_LEFT"
      spacing="10"
      style="-fx-padding: 24; -fx-pref-width: 340;">
    <Label text="Tip Calculator"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label text="Bill Amount ($)"/>
    <TextField fx:id="billAmountField"
               promptText="e.g. 50.00"
               onAction="#calculateTip"/>

    <Label text="Tip Percentage (%)"/>
    <TextField fx:id="tipPercentageField"
               promptText="e.g. 15"
               onAction="#calculateTip"/>

    <Button text="Calculate Tip" onAction="#calculateTip"/>
    <Button text="Reset" onAction="#reset"/>

    <Label fx:id="tipAmountLabel" text=""/>
    <Label fx:id="errorMessageLabel"
           text=""
           wrapText="true"
           style="-fx-text-fill: #b00020;"/>
</VBox>
